---
import Site from '../layouts/Site.astro';
import Hero from '../components/Hero.astro';
import Routes from '../components/Routes.astro';
import Gallery from '../components/Gallery.astro';
import Trouble from '../components/Trouble.astro';
import CTA from '../components/CTA.astro';
import Footer from '../components/Footer.astro';
---
<Site
  title="Vibe Coding at Trivelta"
  description="Ship internal apps in under 10 minutes. The Trivelta Vibe Coders guide to going from idea to live URL."
>
  <div class="wrap">
    <div class="nav">
      <span class="brand"><span class="brand-dot"></span>Trivelta Vibe Coders</span>
      <span class="nav-meta" data-nav-guest>Internal · v1.0.4</span>
      <span class="nav-meta nav-auth" data-nav-auth hidden>
        <span data-nav-email></span>
        <button class="btn btn-sign-out" type="button" data-sign-out>Sign out</button>
      </span>
    </div>

    <main>
      <Hero />
      <Routes />
      <Gallery />
      <Trouble />
      <CTA />
    </main>

    <Footer />
  </div>

  <script>
    import '../scripts/auth-gate';
  </script>
</Site>
