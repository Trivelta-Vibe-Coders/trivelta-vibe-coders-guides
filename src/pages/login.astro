---
import Site from '../layouts/Site.astro';
---

<Site
  title="Sign in · Vibe Coders"
  description="Magic-link sign-in for Trivelta Vibe Coders."
>
  <div class="wrap auth-wrap">
    <div class="nav">
      <span class="brand"><span class="brand-dot"></span>Trivelta Vibe Coders</span>
      <span>Internal · v1.0.4</span>
    </div>

    <main class="auth-main">
      <section class="auth-card">
        <p class="auth-eyebrow">Sign in</p>
        <h1 class="auth-title">Vibe Coders guide</h1>
        <p class="auth-lead">
          Request a magic link with your <strong>@trivelta.com</strong> email. Only existing
          Supabase accounts can sign in.
        </p>

        <form class="auth-form" data-login-form novalidate>
          <label class="auth-label" for="login-email">Email</label>
          <input
            id="login-email"
            class="auth-input"
            type="email"
            name="email"
            autocomplete="email"
            placeholder="you@trivelta.com"
            required
            data-login-email
          />

          <p class="auth-error" data-login-error hidden role="alert"></p>
          <p class="auth-status" data-login-status hidden role="status"></p>

          <button class="btn btn-primary auth-submit" type="submit" data-login-submit>
            Send magic link
          </button>
        </form>
      </section>
    </main>
  </div>

  <script>
    import '../scripts/login';
  </script>
</Site>
